<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>The Grind – Habit Challenge Club</display-name>
    <description>College Java Full-Stack Mini Project demonstrating OOP, Servlets, JSP, JDBC, and Multithreading</description>

    <!-- Welcome File List -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Session Configuration: 30 minutes inactivity timeout -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
    </session-config>

    <!-- Context Parameter for Background Thread Initialization -->
    <context-param>
        <param-name>enableBackgroundReminderThread</param-name>
        <param-value>true</param-value>
    </context-param>

    <!-- Security Authentication Filter -->
    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>com.thegrind.filter.AuthenticationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/dashboard</url-pattern>
        <url-pattern>/dashboard.jsp</url-pattern>
        <url-pattern>/onboarding</url-pattern>
        <url-pattern>/onboarding.jsp</url-pattern>
        <url-pattern>/select-habits</url-pattern>
        <url-pattern>/select-habits.jsp</url-pattern>
        <url-pattern>/reminders</url-pattern>
        <url-pattern>/reminders.jsp</url-pattern>
        <url-pattern>/habit-details</url-pattern>
        <url-pattern>/habit-details.jsp</url-pattern>
        <url-pattern>/progress</url-pattern>
        <url-pattern>/progress.jsp</url-pattern>
        <url-pattern>/profile</url-pattern>
        <url-pattern>/profile.jsp</url-pattern>
        <url-pattern>/settings</url-pattern>
        <url-pattern>/settings.jsp</url-pattern>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>

    <!-- 1. Register Servlet -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.thegrind.servlet.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <!-- 2. Login Servlet -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.thegrind.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!-- 3. Logout Servlet -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.thegrind.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- 4. Dashboard Servlet -->
    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.thegrind.servlet.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <!-- 5. Goal Servlet (Onboarding) -->
    <servlet>
        <servlet-name>GoalServlet</servlet-name>
        <servlet-class>com.thegrind.servlet.GoalServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GoalServlet</servlet-name>
        <url-pattern>/goals</url-pattern>
    </servlet-mapping>

    <!-- 6. Habit Servlet -->
    <servlet>
        <servlet-name>HabitServlet</servlet-name>
        <servlet-class>com.thegrind.servlet.HabitServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HabitServlet</servlet-name>
        <url-pattern>/habits</url-pattern>
        <url-pattern>/habit-details</url-pattern>
    </servlet-mapping>

    <!-- 7. Add Custom Habit Servlet -->
    <servlet>
        <servlet-name>AddHabitServlet</servlet-name>
        <servlet-class>com.thegrind.servlet.AddHabitServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddHabitServlet</servlet-name>
        <url-pattern>/add-habit</url-pattern>
    </servlet-mapping>

    <!-- 8. Complete Habit Servlet -->
    <servlet>
        <servlet-name>CompleteHabitServlet</servlet-name>
        <servlet-class>com.thegrind.servlet.CompleteHabitServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CompleteHabitServlet</servlet-name>
        <url-pattern>/complete-habit</url-pattern>
    </servlet-mapping>

    <!-- 9. Delete Habit Servlet -->
    <servlet>
        <servlet-name>DeleteHabitServlet</servlet-name>
        <servlet-class>com.thegrind.servlet.DeleteHabitServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeleteHabitServlet</servlet-name>
        <url-pattern>/delete-habit</url-pattern>
    </servlet-mapping>

    <!-- 10. Progress Servlet -->
    <servlet>
        <servlet-name>ProgressServlet</servlet-name>
        <servlet-class>com.thegrind.servlet.ProgressServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProgressServlet</servlet-name>
        <url-pattern>/progress</url-pattern>
    </servlet-mapping>

    <!-- 11. Reminder Servlet -->
    <servlet>
        <servlet-name>ReminderServlet</servlet-name>
        <servlet-class>com.thegrind.servlet.ReminderServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReminderServlet</servlet-name>
        <url-pattern>/reminders</url-pattern>
    </servlet-mapping>

    <!-- 12. Profile Servlet -->
    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>com.thegrind.servlet.ProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/profile</url-pattern>
        <url-pattern>/settings</url-pattern>
    </servlet-mapping>

    <!-- 13. Chatbot Servlet (Grind Coach) -->
    <servlet>
        <servlet-name>ChatbotServlet</servlet-name>
        <servlet-class>com.thegrind.servlet.ChatbotServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ChatbotServlet</servlet-name>
        <url-pattern>/chatbot</url-pattern>
        <url-pattern>/api/chat</url-pattern>
    </servlet-mapping>

</web-app>
